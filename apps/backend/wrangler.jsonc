{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vendeya-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // The dashboard Worker owns the custom domain. These routes send the API, the
  // webhook and the public catalog images straight to this Worker.
  "routes": [
    { "pattern": "sales.rising.sh/api/*", "zone_name": "rising.sh" },
    { "pattern": "sales.rising.sh/media/*", "zone_name": "rising.sh" },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vendeya",
      "database_id": "88cac004-1a6e-4f1f-ab7f-a0f5689a6b7e",
      "migrations_dir": "migrations",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "485590a311484a83893acf3779d57e7f",
    },
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "vendeya-files",
    },
  ],
  "images": { "binding": "IMAGES" },
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "CONVERSATIONS", "class_name": "ConversationObject" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ConversationObject"] }],
  "triggers": { "crons": ["* * * * *"] },
  // docs/operations.md says what each variable and secret changes.
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_URL": "https://sales.rising.sh",
    "LOG_LEVEL": "info",
    "GRAPH_API_VERSION": "v26.0",
    "GRAPH_API_BASE_URL": "https://graph.facebook.com",
    "CALIDDA_BASE_URL": "https://appweb.calidda.com.pe",
    "BOT_RESPONSE_DELAY_MS": "2300",
    "PLATFORM_OPS_PHONE_NUMBER_ID": "",
    "WHATSAPP_GROUP_DEV": "",
    // Web Push: the public key the browser subscribes with, and the contact the
    // push services see. Empty values turn push off. The private key is a
    // secret, never a var. apps/backend/scripts/generate-vapid-keys.ts makes a
    // pair.
    "VAPID_PUBLIC_KEY": "",
    "VAPID_SUBJECT": "",
  },
  // Set each with `wrangler secret put <NAME>`. Local values live in .dev.vars.
  "secrets": {
    "required": ["SECRETS_KEY"],
  },
}
