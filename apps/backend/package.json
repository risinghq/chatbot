{
  "name": "@vendeya/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "seed": "bun src/db/seed.ts",
    "account": "bun src/cli/account.ts",
    "clean": "bun x shx rm -rf .wrangler/state",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "bun run types && tsc --noEmit",
    "test": "vitest run",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@vendeya/core": "workspace:*",
    "@vendeya/intelligence": "workspace:*",
    "@vendeya/types": "workspace:*",
    "@vendeya/utils": "workspace:*",
    "hono": "^4.13.19",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.3",
    "@vendeya/tsconfig": "workspace:*",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0"
  }
}
