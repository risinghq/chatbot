{
  "name": "@vendeya/frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build",
    "preview": "bun run build && wrangler dev --port 8788",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir dist",
    "prepare": "svelte-kit sync || echo ''",
    "types": "wrangler types --strict-vars=false --include-main-module=false",
    "typecheck": "bun run types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck:watch": "bun run types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "dependencies": {
    "@vendeya/types": "workspace:*"
  },
  "devDependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@sveltejs/adapter-cloudflare": "^8.0.2",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.5",
    "@vendeya/tsconfig": "workspace:*",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.8",
    "vite-plugin-devtools-json": "^1.1.2",
    "wrangler": "^4.163.0"
  }
}
